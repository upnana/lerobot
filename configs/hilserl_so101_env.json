{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "task": "push the black block",
    "robot": {
      "type": "so101_follower",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5AE6083854-if00",
      "id": "so101_follower",
      "use_degrees": true,
      "cameras": {
        "front": {
          "type": "opencv",
          "index_or_path": "/dev/v4l/by-id/usb-UGREEN_Camera_2K_UGREEN_Camera_2K_SN0001-video-index0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG",
          "warmup_s": 5
        },
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB2.0_CAM1_USB2.0_CAM1-video-index0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG",
          "warmup_s": 5
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5AE6084864-if00",
      "id": "so101_leader",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "max_gripper_pos": 30,
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": false,
