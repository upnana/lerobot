        "reset_time_s": 5.0,
        "control_time_s": 90.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "/home/rxn/SO-ARM100/Simulation/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [0.1178, -0.1125, 0.028],
          "max": [0.4429, 0.1033, 0.0616]
        },
        "end_effector_step_sizes": {
          "x": 0.015,
          "y": 0.015,
          "z": 0.015
        },
        "max_ee_step_m": 0.02,
        "joint_position_bounds": {
          "shoulder_pan": {"min": -25.0, "max": 15.0},
          "wrist_roll": {"min": -20.0, "max": 20.0}
        }
      }
    }
  },
  "dataset": {
    "repo_id": "my_rl/push_black_block_demos",
